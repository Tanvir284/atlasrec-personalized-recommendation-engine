# Docker defaults are local demo credentials; never use these in deployment.
ATLASREC_PROFILE=demo
# Filled by scripts/activate-retail.ps1 after a real catalog and model are installed.
RESEARCH_DATASET_ID=
ATLASREC_ENV=development
DATABASE_URL=postgresql+psycopg://atlasrec:local-demo-password@postgres:5432/atlasrec
POSTGRES_PASSWORD=local-demo-password
REDIS_URL=redis://redis:6379/0
ARTIFACT_DIR=/app/artifacts
DATA_DIR=/app/data
MLFLOW_TRACKING_URI=sqlite:////app/artifacts/mlflow.db
ALLOWED_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://api:8000
COOKIE_SECURE=false
DEMO_ADMIN_EMAIL=admin@atlasrec.local
DEMO_ADMIN_PASSWORD=AtlasDemo!2026
TRAIN_THREADS=2
TRAIN_TIME_BUDGET=300
WORKER_CONCURRENCY=1
# Uvicorn processes for the API. Each loads its own model copy (~RAM per process).
# Promotions are picked up by every process on its next request.
API_WORKERS=1

# Observational drift, minimum nonoverlapping windows and numeric samples
DRIFT_WINDOW=500
DRIFT_CATEGORY_THRESHOLD=0.2
DRIFT_NUMERIC_THRESHOLD=0.5
DRIFT_NUMERIC_MIN_SAMPLES=30
